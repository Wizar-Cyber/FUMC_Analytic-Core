{
  "version": "2.0",
  "functionTimeout": "00:10:00",
  "extensions": {
    "http": {
      "routePrefix": ""
    },
    "serviceBus": {
      "maxConcurrentCalls": 1,
      "prefetchCount": 0
    },
    "durableTask": {
      "hubName": "FumcSatAgentHub"
    }
  },
  "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "excludedTypes": "Request"
      }
    }
  }
}
